# --- Anthropic (LLM) ---
# Get a key at https://console.anthropic.com/. Leave empty to run in deterministic MOCK mode.
ANTHROPIC_API_KEY=
# Fast model recommended for a live demo.
MODEL=claude-sonnet-4-6

# --- Server ---
PORT=3001

# --- Demo safety net ---
# Set to 1 to force the deterministic mock LLM (no network, no key needed).
# When ANTHROPIC_API_KEY is empty, mock mode turns on automatically.
USE_MOCK_LLM=0

# --- Optional: LangSmith tracing (free observability) ---
# Fill these in to auto-enable tracing. Leave blank to disable — the app never crashes if absent.
LANGCHAIN_TRACING_V2=
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=bloomloop
